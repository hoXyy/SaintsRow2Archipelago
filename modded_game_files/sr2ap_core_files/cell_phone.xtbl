<TableTemplates>
	</TableTemplates>

<TableDescription>
	<Name>Cell_entry</Name>
	<Type>TableDescription</Type>
	<Display_Name>Cell Phone Entry</Display_Name>
	<Element>
		<Name>Name</Name>
		<Type>String</Type>
		</Element>
	<Element>
		<Name>DisplayName</Name>
		<Type>Reference</Type>
		<Reference>
			<File>localized_exports\CellPhone_text.xtbl</File>
			<Type>Cell_Identifier.Name</Type>
			<OpenSeparate>False</OpenSeparate>
			</Reference>
		</Element>
	<Element>
		<Name>Number</Name>
		<Type>String</Type>
		</Element>
	<Element>
		<Name>Sound</Name>
		<Type>String</Type>
		<Description>Foley to be played when the other end picks up.</Description>
		</Element>
	<Element>
		<Name>Action</Name>
		<Type>String</Type>
		<Required>false</Required>
		</Element>
	<Element>
		<Name>Flags</Name>
		<Type>Flags</Type>
		<Flag>External Rings</Flag>
		</Element>
	</TableDescription>

<EntryCategories>
	<Category>
		<Name>Entries</Name>
		</Category>
	</EntryCategories>
