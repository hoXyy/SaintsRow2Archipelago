<root>
<Table>
	<Peel_Out>
		<Name>Peel Out</Name>
		<_Editor>
			<Category>Entries</Category>
			</_Editor>
		<Min_Spectators>0</Min_Spectators>
		<Respect_Per_Spectator>10</Respect_Per_Spectator>
		<Max_Watch_Distance>10</Max_Watch_Distance>
		<Max_Reward>0</Max_Reward>
		<Delay_Between>5</Delay_Between>
		</Peel_Out>
	</Table>

<TableTemplates>
	</TableTemplates>

<TableDescription>
	<Name>Peel_Out</Name>
	<Type>TableDescription</Type>
	<Element>
		<Name>Name</Name>
		<Type>String</Type>
		<Description>Unused.</Description>
		</Element>
	<Element>
		<Name>Max_Reward</Name>
		<Type>Float</Type>
		<Display_Name>Maximum Reward</Display_Name>
		<Description>Maximum totel reward possible from one instance of this stunt.</Description>
		<Default>8</Default>
		<MinValue>0</MinValue>
		</Element>
	<Element>
		<Name>Min_Spectators</Name>
		<Type>Int</Type>
		<Display_Name>Minimum Spectators</Display_Name>
		<Description>Minimum number of spectators before this stunt starts.</Description>
		<Default>1</Default>
		<MinValue>0</MinValue>
		</Element>
	<Element>
		<Name>Respect_Per_Spectator</Name>
		<Type>Float</Type>
		<Display_Name>Respect per Spectator</Display_Name>
		<Description>Reward for each spectator after the minimum that watches the burnout.</Description>
		<Default>1</Default>
		<MinValue>0</MinValue>
		</Element>
	<Element>
		<Name>Max_Watch_Distance</Name>
		<Type>Float</Type>
		<Display_Name>Maximum Watching Distance</Display_Name>
		<Description>Maximum distance at which pedestrians will watch the player burnout, in meters.</Description>
		<Default>10</Default>
		<MinValue>5</MinValue>
		</Element>
	<Element>
		<Name>Delay_Between</Name>
		<Type>Float</Type>
		<Display_Name>Delay Between Instances</Display_Name>
		<Description>Delay between consecutive instances of this stunt, in seconds.</Description>
		<Default>1</Default>
		<MinValue>0</MinValue>
		</Element>
	</TableDescription>

<EntryCategories>
	<Category>
